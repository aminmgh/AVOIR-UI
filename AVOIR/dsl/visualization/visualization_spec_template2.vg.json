{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "description": "A visualization of a fairness specification written in our grammar",
  "autosize": {
    "type": "fit",
    "resize": true,
    "contains": "padding"
  },
  "padding": 20,
  "signals": [
    {
      "name": "points",
      "value": false,
      "bind": {
        "input": "checkbox"
      }
    },
    {
      "name": "node1_selection",
      "value": {},
      "on": [
        {
          "events": "symbol:dblclick",
          "update": "datum && datum.y < inner_height/2 ? datum : node1_selection"
        }
      ]
    },
    {
      "name": "node2_selection",
      "value": {},
      "on": [
        {
          "events": "symbol:dblclick",
          "update": "datum && datum.y >= inner_height/2 ? datum : node2_selection"
        }
      ]
    },
    {
      "name": "inner_height",
      "update": "height-(padding.top + padding.bottom)"
    },
    {
      "name": "tree_width",
      "update": "width * (5/9)"
    },
    {
      "name": "plot_padding",
      "update": "20"
    },
    {
      "name": "plot_width",
      "update": "width - tree_width"
    },
    {
      "name": "plot_height",
      "update": "(inner_height-(plot_padding*2))/2"
    },
    {
      "name": "plot_x_range",
      "update": "[0, plot_width]"
    },
    {
      "name": "plot_y_range",
      "update": "[0, plot_height]"
    },
    {
      "name": "TopChart_line_value",
      "value": 0.5,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 2,
        "step": 0.001
      }
    },
    {
      "name": "BottomChart_line_value",
      "value": 0.5,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 2,
        "step": 0.001
      }
    }
  ],
  "data": [
    {
      "name": "tree",
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent_id"
        },
        {
          "type": "tree",
          "method": "tidy",
          "size": [
            {
              "signal": "inner_height"
            },
            {
              "signal": "tree_width"
            }
          ],
          "separation": true,
          "as": [
            "y",
            "x",
            "depth",
            "children"
          ]
        }
      ]
    },
    {
      "name": "links",
      "source": "tree",
      "transform": [
        {
          "type": "treelinks"
        },
        {
          "type": "linkpath",
          "shape": "diagonal",
          "orient": "horizontal"
        }
      ]
    },
    {
      "name": "node_data",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.repr == node1_selection.repr"
        },
        {
          "type": "flatten",
          "fields": [
            "timesteps",
            "values",
            "probs",
            "uppers",
            "lowers"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.probs <= 1.0 && datum.probs >= 0.0"
        }
      ]
    },
    {
      "name": "node2_data",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.repr == node2_selection.repr"
        },
        {
          "type": "flatten",
          "fields": [
            "timesteps",
            "values",
            "probs",
            "uppers",
            "lowers"
          ]
        },
        {
          "type": "filter",
          "expr": "datum.probs <= 1.0 && datum.probs >= 0.0"
        }
      ]
    },
    {
      "name": "shared_node_data_aggregates",
      "source": [
        "node_data",
        "node2_data"
      ],
      "transform": [
        {
          "type": "aggregate",
          "ops": [
            "min",
            "max"
          ],
          "fields": [
            "timesteps",
            "timesteps"
          ],
          "as": [
            "min_timestep",
            "max_timestep"
          ]
        },
        {
          "type": "formula",
          "as": "timesteps_domain",
          "expr": "[datum.min_timestep, datum.max_timestep]"
        },
        {
          "type": "flatten",
          "fields": [
            "timesteps_domain"
          ]
        },
        {
          "type": "collect",
          "sort": {
            "field": "timesteps_domain"
          }
        }
      ]
    },
    {
      "name": "node_data_aggregates",
      "source": "node_data",
      "transform": [
        {
          "type": "aggregate",
          "ops": [
            "min",
            "max"
          ],
          "fields": [
            "lowers",
            "uppers"
          ],
          "as": [
            "min_value",
            "max_value"
          ]
        },
        {
          "type": "formula",
          "as": "values_domain",
          "expr": "[min(0, datum.min_value || 0), max(2, datum.max_value || 0)]"
        },
        {
          "type": "flatten",
          "fields": [
            "values_domain"
          ]
        },
        {
          "type": "collect",
          "sort": {
            "field": "values_domain"
          }
        }
      ]
    },
    {
      "name": "node2_data_aggregates",
      "source": "node2_data",
      "transform": [
        {
          "type": "aggregate",
          "ops": [
            "min",
            "max"
          ],
          "fields": [
            "lowers",
            "uppers"
          ],
          "as": [
            "min_value",
            "max_value"
          ]
        },
        {
          "type": "formula",
          "as": "values_domain",
          "expr": "[min(0, datum.min_value || 0), max(2, datum.max_value || 0)]"
        },
        {
          "type": "flatten",
          "fields": [
            "values_domain"
          ]
        },
        {
          "type": "collect",
          "sort": {
            "field": "values_domain"
          }
        }
      ]
    }
  ],
  "scales": [
    {
      "name": "color",
      "type": "linear",
      "range": {
        "scheme": "magma"
      },
      "domain": {
        "data": "tree",
        "field": "depth"
      },
      "zero": true
    }
  ],
  "layout": {
    "padding": 20,
    "bounds": "full",
    "align": "each",
    "center": {
      "row": true,
      "column": true
    },
    "columns": 2
  },
  "marks": [
    {
      "type": "group",
      "name": "tree_group",
      "encode": {
        "update": {
          "width": {
            "signal": "tree_width"
          },
          "height": {
            "signal": "inner_height"
          }
        }
      },
      "marks": [
        {
          "type": "path",
          "from": {
            "data": "links"
          },
          "encode": {
            "update": {
              "path": {
                "field": "path"
              },
              "stroke": {
                "value": "#ccc"
              }
            }
          }
        },
        {
          "type": "symbol",
          "from": {
            "data": "tree"
          },
          "encode": {
            "enter": {
              "size": {
                "value": 900
              },
              "stroke": {
                "value": "#fff"
              }
            },
            "update": {
              "x": {
                "field": "x"
              },
              "y": {
                "field": "y"
              },
              "fill": {
                "scale": "color",
                "field": "depth"
              }
            },
            "hover": {
              "fill": {
                "value": "green"
              }
            }
          }
        },
        {
          "type": "text",
          "from": {
            "data": "tree"
          },
          "encode": {
            "enter": {
              "text": {
                "field": "repr",
                "signal": "replace(datum.repr, /]/g, ']] ')"
              },
              "fontSize": {
                "value": 15
              },
              "baseline": {
                "value": "middle"
              },
              "lineBreak": {
                "value": "] "
              }
            },
            "update": {
              "x": {
                "field": "x"
              },
              "y": {
                "field": "y"
              },
              "dx": {
                "signal": "datum.children ? -15 : 15"
              },
              "align": {
                "signal": "datum.children ? 'right' : 'left'"
              }
            }
          }
        }
      ]
    },
    {
      "type": "group",
      "name": "assistant_plots_group",
      "encode": {
        "update": {
          "width": {
            "signal": "plot_width"
          },
          "height": {
            "signal": "inner_height"
          }
        }
      },
      "layout": {
        "padding": {
          "signal": "plot_padding"
        },
        "bounds": "full",
        "align": "each",
        "center": {
          "row": true,
          "column": false
        },
        "columns": 1
      },
      "scales": [
        {
          "name": "x_shared",
          "type": "linear",
          "range": {
            "signal": "plot_x_range"
          },
          "domain": {
            "data": "shared_node_data_aggregates",
            "field": "timesteps_domain"
          },
          "zero": true
        },
        {
          "name": "x_band",
          "type": "band",
          "range": {
            "signal": "plot_x_range"
          },
          "domain": {
            "data": "node_data",
            "field": "timesteps"
          },
          "padding": 0.05
        },
        {
          "name": "y_prob",
          "type": "linear",
          "nice": true,
          "range": {
            "signal": "plot_y_range"
          },
          "zero": false,
          "reverse": true,
          "domain": [
            0,
            1
          ]
        }
      ],
      "marks": [
        {
          "type": "group",
          "name": "plot1_group",
          "encode": {
            "update": {
              "width": {
                "signal": "plot_width"
              },
              "height": {
                "signal": "plot_height"
              }
            }
          },
          "title": {
            "text": {
              "signal": "node1_selection.repr"
            },
            "fontSize": {
              "value": 15
            }
          },
          "scales": [
            {
              "name": "y",
              "type": "linear",
              "nice": true,
              "range": {
                "signal": "plot_y_range"
              },
              "zero": false,
              "reverse": true,
              "domain": {
                "data": "node_data_aggregates",
                "field": "values_domain"
              }
            }
          ],
          "axes": [
            {
              "orient": "bottom",
              "scale": "x_shared",
              "title": "# Observed",
              "domainWidth": 3,
              "domainColor": "steelblue",
              "titleColor": "steelblue",     
              "titleFontSize": 15          
            },
            {
              "orient": "left",
              "scale": "y",
              "title": "Value of the selected node",
              "domainWidth": 3,
              "domainColor": "steelblue",
              "titleColor": "steelblue",
              "titleFontSize": 15
            }
          ],
          "marks": [
            {
              "type": "area",
              "from": {"data": "node_data"},
              "encode": {
                  "enter": {
                      "x": {"scale": "x_shared", "field": "timesteps"},
                      "y": {"scale": "y", "field": "uppers"},
                      "y2": {"scale": "y", "field": "lowers"},
                      "fill": {"value": "lightblue"},
                      "fillOpacity": {"value": 0.3}
                  }
              }
            },
            {
              "type": "line",
              "from": {
                "data": "node_data"
              },
              "encode": {
                "enter": {
                  "x": {
                    "scale": "x_shared",
                    "field": "timesteps"
                  },
                  "y": {
                    "scale": "y",
                    "field": "values"
                  },
                  "strokeWidth": {
                    "value": 2
                  },
                  "stroke": {
                    "value": "steelblue"
                  }
                },
                "update": {
                  "interpolate": {
                    "value": "linear"
                  },
                  "strokeOpacity": {
                    "value": 1
                  }
                }
              }
            },
            {
              "name": "marks",
              "type": "symbol",
              "from": {
                "data": "node_data"
              },
              "encode": {
                "update": {
                  "x": {
                    "scale": "x_shared",
                    "field": "timesteps"
                  },
                  "y": {
                    "scale": "y",
                    "field": "values"
                  },
                  "size": {
                    "value": 30
                  },
                  "shape": {
                    "value": "circle"
                  },
                  "strokeWidth": {
                    "value": 2
                  },
                  "opacity": {
                    "signal": "if(points, 0.5, 0)"
                  },
                  "stroke": {
                    "value": "steelblue"
                  },
                  "fill": {
                    "value": "transparent"
                  }
                }
              }
            },
            {
              "type": "rect",
              "from": {
                "data": "node_data"
              },
              "encode": {
                "enter": {
                  "x": {
                    "scale": "x_band",
                    "field": "timesteps"
                  },
                  "width": {
                    "scale": "x_band",
                    "band": 1
                  },
                  "y": {
                    "scale": "y_prob",
                    "field": "probs"
                  },
                  "y2": {
                    "scale": "y_prob",
                    "value": 1
                  }
                },
                "update": {
                  "fill": {
                    "value": "green"
                  },
                  "fillOpacity": {
                    "value": 0.1
                  }
                }
              }
            },
            {
              "type": "rect",
              "from": {
                "data": "node_data"
              },
              "encode": {
                "enter": {
                  "x": {
                    "scale": "x_band",
                    "field": "timesteps"
                  },
                  "width": {
                    "scale": "x_band",
                    "band": 1
                  },
                  "y": {
                    "scale": "y_prob",
                    "field": "probs"
                  },
                  "y2": {
                    "scale": "y_prob",
                    "value": 0
                  }
                },
                "update": {
                  "fill": {
                    "value": "red"
                  },
                  "fillOpacity": {
                    "value": 0.1
                  }
                }
              }
            },
            {
              "type": "rule",
              "encode": {
                "update": {
                  "x": { "value": 0 },
                  "x2": { "signal": "plot_width" },
                  "y": { "scale": "y", "signal": "TopChart_line_value" },
                  "stroke": { "value": "green" },
                  "strokeDash": { "value": [4, 4] },
                  "strokeWidth": { "value": 3 }
                }
              }
            }
          ]
        },
        {
          "type": "group",
          "name": "plot2_group",
          "encode": {
            "update": {
              "width": {
                "signal": "plot_width"
              },
              "height": {
                "signal": "plot_height"
              }
            }
          },
          "title": {
            "text": {
              "signal": "node2_selection.repr"
            },
            "fontSize": {
              "value": 15
            }
          },
          "scales": [
            {
              "name": "y",
              "type": "linear",
              "nice": true,
              "range": {
                "signal": "plot_y_range"
              },
              "zero": false,
              "reverse": true,
              "domain": {
                "data": "node2_data_aggregates",
                "field": "values_domain"
              }
            }
          ],
          "axes": [
            {
              "orient": "bottom",
              "scale": "x_shared",
              "title": "# Observed",
              "domainWidth": 3,
              "domainColor": "steelblue",
              "titleColor": "steelblue",     
              "titleFontSize": 15          
            },
            {
              "orient": "left",
              "scale": "y",
              "title": "Value of the selected node",
              "domainWidth": 3,
              "domainColor": "steelblue",
              "titleColor": "steelblue",
              "titleFontSize": 15
            }
          ],
          "marks": [
            {
              "type": "area",
              "from": {"data": "node2_data"},
              "encode": {
                  "enter": {
                      "x": {"scale": "x_shared", "field": "timesteps"},
                      "y": {"scale": "y", "field": "uppers"},
                      "y2": {"scale": "y", "field": "lowers"},
                      "fill": {"value": "lightblue"},
                      "fillOpacity": {"value": 0.3}
                  }
              }
            },
            {
              "type": "line",
              "from": {
                "data": "node2_data"
              },
              "encode": {
                "enter": {
                  "x": {
                    "scale": "x_shared",
                    "field": "timesteps"
                  },
                  "y": {
                    "scale": "y",
                    "field": "values"
                  },
                  "strokeWidth": {
                    "value": 2
                  },
                  "stroke": {
                    "value": "steelblue"
                  }
                },
                "update": {
                  "interpolate": {
                    "value": "linear"
                  },
                  "strokeOpacity": {
                    "value": 1
                  }
                }
              }
            },
            {
              "name": "marks",
              "type": "symbol",
              "from": {
                "data": "node2_data"
              },
              "encode": {
                "update": {
                  "x": {
                    "scale": "x_shared",
                    "field": "timesteps"
                  },
                  "y": {
                    "scale": "y",
                    "field": "values"
                  },
                  "size": {
                    "value": 30
                  },
                  "shape": {
                    "value": "circle"
                  },
                  "strokeWidth": {
                    "value": 2
                  },
                  "opacity": {
                    "signal": "if(points, 0.5, 0)"
                  },
                  "stroke": {
                    "value": "steelblue"
                  },
                  "fill": {
                    "value": "transparent"
                  }
                }
              }
            },
            {
              "type": "rect",
              "from": {
                "data": "node2_data"
              },
              "encode": {
                "enter": {
                  "x": {
                    "scale": "x_band",
                    "field": "timesteps"
                  },
                  "width": {
                    "scale": "x_band",
                    "band": 1
                  },
                  "y": {
                    "scale": "y_prob",
                    "field": "probs"
                  },
                  "y2": {
                    "scale": "y_prob",
                    "value": 1
                  }
                },
                "update": {
                  "fill": {
                    "value": "green"
                  },
                  "fillOpacity": {
                    "value": 0.1
                  }
                }
              }
            },
            {
              "type": "rect",
              "from": {
                "data": "node2_data"
              },
              "encode": {
                "enter": {
                  "x": {
                    "scale": "x_band",
                    "field": "timesteps"
                  },
                  "width": {
                    "scale": "x_band",
                    "band": 1
                  },
                  "y": {
                    "scale": "y_prob",
                    "field": "probs"
                  },
                  "y2": {
                    "scale": "y_prob",
                    "value": 0
                  }
                },
                "update": {
                  "fill": {
                    "value": "red"
                  },
                  "fillOpacity": {
                    "value": 0.1
                  }
                }
              }
            },
            {
              "type": "rule",
              "encode": {
                "update": {
                  "x": { "value": 0 },
                  "x2": { "signal": "plot_width" },
                  "y": { "scale": "y", "signal": "BottomChart_line_value" },
                  "stroke": { "value": "green" },
                  "strokeDash": { "value": [4, 4] },
                  "strokeWidth": { "value": 3 }
                }
              }
            }
          ]
        }
      ]
    }
  ]
}